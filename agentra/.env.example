DATABASE_URL=postgres://agentra:agentra_dev@localhost:5432/agentra

# Admin treasury (change in production)
AGENTRA_ADMIN_PASSWORD=your-strong-password
AGENTRA_ADMIN_TOKEN=long-random-token-for-cookie

# Session signing (user auth)
AGENTRA_SESSION_SECRET=long-random-session-secret

# Cron — Authorization: Bearer <secret>
CRON_SECRET=dev-cron-secret

# User deposits: send USDT TRC-20 TO this treasury FROM any compatible wallet; claim by tx hash
# 34-char Tron base58 address (T + 33 chars). Example mock for local dev:
AGENTRA_TREASURY_TRC20=TXkPq8vN2mR7sL4wY9hJ3fG6dA1cB5eH8n

# Local MVP: mock Tron verify + payouts (mock_license_100, mock_topup_250)
AGENTRA_MOCK_TRON=true

# TronGrid (deposit indexer + optional payout treasury key)
TRON_API_KEY=
TRON_FULL_HOST=https://api.trongrid.io
TRON_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
TRON_TREASURY_PRIVATE_KEY=
