DATABASE_URL=postgres://agentra:agentra_dev@localhost:5432/agentra

# Admin treasury (change in production)
AGENTRA_ADMIN_PASSWORD=your-strong-password
AGENTRA_ADMIN_TOKEN=long-random-token-for-cookie

# Session signing (user auth)
AGENTRA_SESSION_SECRET=long-random-session-secret

# Cron — Authorization: Bearer <secret> (Vercel Cron uses this automatically)
CRON_SECRET=dev-cron-secret
# AGENTRA_CRON_ALLOW_QUERY=true  # optional: ?secret= for private schedulers only

# User deposits: send USDT TRC-20 TO this treasury FROM any compatible wallet; claim by tx hash
# 34-char Tron base58 address (T + 33 chars). Example mock for local dev:
AGENTRA_TREASURY_TRC20=TXkPq8vN2mR7sL4wY9hJ3fG6dA1cB5eH8n

# Local MVP: mock Tron verify + payouts (mock_license_100, mock_topup_250)
AGENTRA_MOCK_TRON=true

# Live EVM signing (default Sepolia testnet — use mainnet only when ready)
AGENTRA_LIVE_CHAIN_ID=11155111
AGENTRA_LIVE_TX_MODE=swap
AGENTRA_LIVE_SWAP_STYLE=wrap
AGENTRA_LIVE_MAX_ETH_SWAP=0.002
NEXT_PUBLIC_AGENTRA_LIVE_CHAIN_ID=11155111
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://rpc.sepolia.org
SEPOLIA_RPC_URL=https://rpc.sepolia.org
ETHEREUM_RPC_URL=https://eth.llamarpc.com

# Stripe (optional — otherwise license via USDT TRC-20 /fund)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LICENSE_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# TronGrid (deposit indexer + live payout verification)
# Production: set AGENTRA_MOCK_TRON=false and TRON_API_KEY (TronGrid Pro)
TRON_API_KEY=
TRON_FULL_HOST=https://api.trongrid.io
TRON_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
TRON_TREASURY_PRIVATE_KEY=
AGENTRA_TRON_MIN_CONFIRMATIONS=19
AGENTRA_TRON_INDEXER_MAX_PAGES=5
AGENTRA_TRON_PAYOUT_DELAY_MS=800
