# Meta (Facebook Page + Instagram)
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=

# Hello Peter: email (IMAP) or api
HELLOPETER_MODE=email
HELLOPETER_IMAP_HOST=
HELLOPETER_IMAP_USER=
HELLOPETER_IMAP_PASSWORD=
HELLOPETER_IMAP_FOLDER=INBOX
HELLOPETER_API_URL=
HELLOPETER_API_KEY=

# Client identifiers (POPIA: restrict EXCEL_OUTPUT_DIR access)
POLICY_REGEX=(?i)\b(?:POL|CLT)[-\s]?\d{6,12}\b
EXCEL_OUTPUT_DIR=./output

# Classification (optional — keyword fallback if unset)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Alerts (masked — no PII in message body)
TEAMS_WEBHOOK_URL=
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_EMAIL_TO=

# Matching & SLA
SIMILARITY_THRESHOLD=0.55
SLA_AMBER_HOURS=24
SLA_RED_HOURS=72

# Storage
DATABASE_PATH=./data/sweep.db
LATEST_EXCEL_NAME=social_sweep_LATEST.xlsx

# Set true in containers to skip writing Excel/DB side effects during health checks
SWEEP_SKIP_PERSIST=false
